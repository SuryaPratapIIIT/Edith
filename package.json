{
  "name": "velo-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"python -m uvicorn main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload\" \"vite\"",
    "dev:frontend": "vite",
    "dev:backend": "python -m uvicorn main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"python -m uvicorn main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload\" \"vite\"",
    "dev:full": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND,TUNNEL\" -c \"blue,green,magenta\" \"python -m uvicorn main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload\" \"vite\" \"python -u scripts/tunnel_supervisor.py\"",
    "tunnel": "python -u scripts/tunnel_supervisor.py",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@bolna/web-call": "^3.0.1",
    "@turf/turf": "^7.4.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "canvas-confetti": "^1.9.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.65.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
