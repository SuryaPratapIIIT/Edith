# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=8000
HOST="0.0.0.0"
ENVIRONMENT="production"

# Public URL of this backend (e.g. your Render web service URL or ngrok domain for local dev)
BACKEND_PUBLIC_URL="https://your-backend-app.onrender.com"

# ==========================================
# GNANI AI VOICE SUITE (STT PRISMA & TTS TIMBRE)
# ==========================================
# Gnani Voice API key from https://app.gnani.ai/voice
GNANI_API_KEY="your_gnani_api_key_here"
GNANI_BASE_URL="https://api.vachana.ai"

# STT Model: prisma-v2.5 (default) or prisma-v3.0 (with indic-auto and context hints)
GNANI_STT_MODEL="prisma-v2.5"

# TTS Model: timbre-v2.5 (42 voices) or timbre-v3.0 (13 cross-lingual voices)
GNANI_TTS_MODEL="timbre-v2.5"

# Pre-defined TTS Voices
# English: Pranav, Kaveri, Trupti, Devika, Shlok, Girish
# Hindi / Hinglish: Nalini, Bhavna, Yashvi, Deepak, Roopesh, Vikrant
GNANI_TTS_VOICE_EN="Pranav"
GNANI_TTS_VOICE_HI="Nalini"
GNANI_SPEED=1.0


# ==========================================
# PACE ENGINE SAFETY DEFAULTS
# ==========================================
# 4% safety margin against GPS/camera clock mismatch
SAFETY_MARGIN=0.04
# Alert amber when within 5 km/h of ceiling
AMBER_GAP_KMH=5.0

# ==========================================
# DATA PATHS
# ==========================================
GANTRIES_FILE_PATH="./data/gantries.json"
