# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=8000
HOST="0.0.0.0"
ENVIRONMENT="development"

# Public URL of this backend (e.g. your Render web service URL or ngrok domain for local dev)
BACKEND_PUBLIC_URL="http://127.0.0.1:8000"

# ==========================================
# GNANI AI VOICE SUITE (STT PRISMA & TTS TIMBRE)
# ==========================================
# Gnani Voice API key from https://app.gnani.ai/voice
GNANI_API_KEY="your_gnani_api_key_here"
GNANI_BASE_URL="https://api.vachana.ai"

# STT Model: prisma-v3.0 (with indic-auto)
GNANI_STT_MODEL="prisma-v3.0"

# TTS Model: timbre-v3.0 (cross-lingual voices)
GNANI_TTS_MODEL="timbre-v3.0"

# Pre-defined TTS Voices
GNANI_TTS_VOICE_EN="Avinash"
GNANI_TTS_VOICE_HI="Shivani"
GNANI_SPEED=1.0

# ==========================================
# PACE ENGINE SAFETY DEFAULTS
# ==========================================
SAFETY_MARGIN=0.04
AMBER_GAP_KMH=5.0

# ==========================================
# DATA PATHS
# ==========================================
GANTRIES_FILE_PATH="./data/gantries.json"
