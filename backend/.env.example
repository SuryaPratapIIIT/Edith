# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=8000
HOST="0.0.0.0"
ENVIRONMENT="production"

# Public URL of this backend (e.g. your Render web service URL or ngrok domain for local dev)
BACKEND_PUBLIC_URL="https://your-backend-app.onrender.com"

# ==========================================
# BOLNA VOICE AGENT (TELEPHONY & WEB CALL LAYER)
# ==========================================
BOLNA_API_KEY="your_bolna_api_key_here"
BOLNA_AGENT_ID="your_bolna_agent_id_here"
BOLNA_API_URL="https://api.bolna.ai"

# ==========================================
# PACE ENGINE SAFETY DEFAULTS
# ==========================================
# 4% safety margin against GPS/camera clock mismatch
SAFETY_MARGIN=0.04
# Alert amber when within 5 km/h of ceiling
AMBER_GAP_KMH=5.0

# ==========================================
# DATA PATHS
# ==========================================
GANTRIES_FILE_PATH="./data/gantries.json"

